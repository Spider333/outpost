#!/usr/bin/env bash
# Outpost: from zero to your own read node and client, in three commands.
#
#   ./outpost provision   rent a server (DigitalOcean or Hetzner) with a 1.2 TB disk (1 TB on Hetzner)
#   ./outpost node        start a Snapchain read node on it; no API keys
#   ./outpost client      run the web client on your machine, talking to your node
#
# Also: ./outpost status, ./outpost cli <args>, ./outpost uninstall, ./outpost destroy,
# ./outpost watchdog start|stop|status (deletes a trial server for you)
# Society node, used by members from their own browsers: ./outpost society on|off|status,
# ./outpost members add <name>, ./outpost members remove <name>, ./outpost members list
# Every command is safe to run twice. Add --dry-run to provision/destroy to see the
# exact provider commands without running them.

set -euo pipefail

OUTPOST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="${OUTPOST_STATE_DIR:-$OUTPOST_DIR/.outpost}"
STATE_FILE="$STATE_DIR/state"
TUNNEL_PORT="${OUTPOST_TUNNEL_PORT:-13381}"
CLIENT_PORT="${OUTPOST_PORT:-8381}"

# This tool used to be called kit. Carry its server state and app key over once.
[ -n "${OUTPOST_STATE_DIR:-}" ] || [ ! -d "$OUTPOST_DIR/.kit" ] || [ -e "$STATE_DIR" ] || mv "$OUTPOST_DIR/.kit" "$STATE_DIR"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
[ ! -d "$CONFIG_HOME/kit" ] || [ -e "$CONFIG_HOME/outpost" ] || mv "$CONFIG_HOME/kit" "$CONFIG_HOME/outpost"

DRY_RUN=0
ASSUME_YES=0

say() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Runs a command, or with --dry-run prints it exactly as it would run.
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  [ "$DRY_RUN" -eq 1 ] && return 0
  local reply
  read -r -p "$1 [y/N] " reply
  [[ "$reply" =~ ^[Yy](es)?$ ]]
}

# ---- state

state_get() {
  [ -f "$STATE_FILE" ] || return 0
  # 2>/dev/null: the watchdog or a destroy can remove the file between the check and the read.
  grep -E "^$1=" "$STATE_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true
}

state_set() {
  [ "$DRY_RUN" -eq 1 ] && return 0
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  local tmp="$STATE_FILE.tmp"
  {
    if [ -f "$STATE_FILE" ]; then grep -vE "^$1=" "$STATE_FILE" || true; fi
    echo "$1=$2"
  } >"$tmp"
  mv "$tmp" "$STATE_FILE"
}

# ---- SSH

ssh_key_path() {
  local k="${OUTPOST_SSH_KEY:-$(state_get SSH_KEY)}"
  if [ -z "$k" ]; then
    for c in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/outpost_ed25519"; do
      [ -f "$c" ] && [ -f "$c.pub" ] && { k="$c"; break; }
    done
  fi
  if [ -z "$k" ]; then
    k="$HOME/.ssh/outpost_ed25519"
    # This function's stdout is the key path, so messages go to stderr.
    say "creating SSH key $k" >&2
    if [ "$DRY_RUN" -eq 1 ]; then
      run ssh-keygen -q -t ed25519 -N "" -C "outpost" -f "$k" >&2
    else
      mkdir -p "$HOME/.ssh"
      chmod 700 "$HOME/.ssh"
      ssh-keygen -q -t ed25519 -N "" -C "outpost" -f "$k" >&2
    fi
  fi
  echo "$k"
}

node_host() {
  local ip="${OUTPOST_HOST:-$(state_get IP)}"
  [ -n "$ip" ] || die "no server yet. Run ./outpost provision first, or set OUTPOST_HOST=<ip> for a server you already have."
  echo "$ip"
}

# Host keys are kept per project, so a new server that reuses an old IP (common after
# destroy + provision) does not trip over a stale entry in ~/.ssh/known_hosts. Agent forwarding
# stays off even if ~/.ssh/config turns it on, so a compromised server cannot use your keys.
SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o "UserKnownHostsFile=$STATE_DIR/known_hosts" -o ForwardAgent=no -o ConnectTimeout=15 -o ServerAliveInterval=30)

node_ssh() { node_ssh_for 0 "$@"; }

# Like node_ssh, but with $1 > 0 the ssh is killed after $1 seconds, so a command that hangs
# on the server (a stuck Docker daemon) cannot block the caller. perl's alarm survives exec,
# and perl is on Linux and macOS (which has no `timeout`).
node_ssh_for() {
  local secs="$1"
  shift
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  local key host
  host="$(node_host)"
  key="$(ssh_key_path)"
  if [ "$secs" -gt 0 ]; then
    perl -e 'alarm shift; exec @ARGV or exit 127' "$secs" ssh -i "$key" "${SSH_OPTS[@]}" "root@$host" "$@"
    return
  fi
  ssh -i "$key" "${SSH_OPTS[@]}" "root@$host" "$@"
}

# ---- providers

pick_provider() {
  local p="${1:-$(state_get PROVIDER)}"
  if [ -z "$p" ]; then
    if command -v doctl >/dev/null 2>&1; then p="do"
    elif command -v hcloud >/dev/null 2>&1; then p=hetzner
    elif [ "$DRY_RUN" -eq 1 ]; then p="do"; warn "neither doctl nor hcloud is installed; showing DigitalOcean (use --provider hetzner for Hetzner)"
    else die "neither doctl (DigitalOcean) nor hcloud (Hetzner) is installed. Install one and log in:
  DigitalOcean: https://docs.digitalocean.com/reference/doctl/how-to/install/ then doctl auth init
  Hetzner:      https://github.com/hetznercloud/cli then hcloud context create outpost
Or use a server you already have (Ubuntu 24.04, root SSH, at least 1 TB of disk): OUTPOST_HOST=<ip> ./outpost node"
    fi
  fi
  case "$p" in "do"|digitalocean) echo "do" ;; hetzner|hcloud) echo hetzner ;; *) die "unknown provider: $p (use do or hetzner)" ;; esac
}

require_cli() {
  local bin="$1" hint="$2"
  if ! command -v "$bin" >/dev/null 2>&1; then
    if [ "$DRY_RUN" -eq 1 ]; then warn "$bin is not installed (dry run continues)"; return 0; fi
    die "$bin is not installed. $hint"
  fi
}

# Runs a provider lookup. If the provider CLI fails (not logged in, network), say so instead
# of letting set -e/pipefail end the script without a message.
plist() {
  local out
  if ! out="$("$@" 2>&1)"; then
    printf 'error: %s failed:\n%s\n' "$*" "$out" >&2
    return 1
  fi
  [ -z "$out" ] || printf '%s\n' "$out"
}

# On a dry run the SSH key may not exist yet (it is only "created" on paper): use placeholders.
md5_fingerprint() {
  if [ "$DRY_RUN" -eq 1 ] && [ ! -f "$1" ]; then echo "<md5 fingerprint of $1>"; return 0; fi
  ssh-keygen -E md5 -lf "$1" | awk '{print $2}' | sed 's/^MD5://'
}

render_cloud_init() {
  local pub="$1" out="$2"
  local key
  if [ "$DRY_RUN" -eq 1 ] && [ ! -f "$pub" ]; then key="<contents of $pub>"; else key="$(cat "$pub")"; fi
  sed "s#__SSH_PUBLIC_KEY__#${key}#" "$OUTPOST_DIR/infra/cloud-init.yml" >"$out"
  if [ "$DRY_RUN" -eq 1 ]; then
    say "--- user data that would be sent ($out):"
    cat "$out"
    say "---"
  fi
}

do_server_ip() {
  plist doctl compute droplet list --format Name,PublicIPv4 --no-header | awk -v n="$1" '$1==n {print $2; exit}'
}

# DigitalOcean sometimes creates the droplet without attaching the volume named in --volumes
# (seen 2026-10-18). Check, and attach it if needed. Safe to run again.
do_ensure_attached() {
  local name="$1" vol_id did
  [ "$DRY_RUN" -eq 1 ] && return 0
  vol_id="$(plist doctl compute volume list --format ID,Name --no-header | awk -v n="$name-data" '$2==n {print $1; exit}')"
  did="$(plist doctl compute droplet list --format ID,Name --no-header | awk -v n="$name" '$2==n {print $1; exit}')"
  [ -n "$vol_id" ] && [ -n "$did" ] || return 0
  doctl compute volume get "$vol_id" --format DropletIDs --no-header | grep -qw "$did" && return 0
  say "volume $name-data is not attached to $name; attaching it"
  run doctl compute volume-action attach "$vol_id" "$did" --wait
}

provision_do() {
  local name="$1" region="${2:-fra1}" size="${3:-s-8vcpu-32gb-amd}" key="$4" disk="$5"
  require_cli doctl "See https://docs.digitalocean.com/reference/doctl/how-to/install/ then run: doctl auth init"
  local ip=""
  [ "$DRY_RUN" -eq 0 ] && ip="$(do_server_ip "$name")"
  if [ -n "$ip" ]; then
    say "droplet $name already exists at $ip"
    do_ensure_attached "$name"
    state_set PROVIDER "do"; state_set NAME "$name"; state_set IP "$ip"
    return 0
  fi
  say "DigitalOcean: droplet $name ($size) in $region with a $disk GB volume."
  say "Billed by the hour while it exists: the volume about \$$(awk -v g="$disk" 'BEGIN { printf "%.2f", g * 0.10 / 730 }')/h, plus the droplet"
  say "(s-8vcpu-32gb-amd is \$0.25/h). October 2026 list prices; check yours."
  confirm "Create it now?" || die "cancelled"

  local fp ud
  fp="$(md5_fingerprint "$key.pub")"
  if [ "$DRY_RUN" -eq 1 ] || ! doctl compute ssh-key get "$fp" >/dev/null 2>&1; then
    run doctl compute ssh-key import "$name-key" --public-key-file "$key.pub"
  fi
  local vol_id="<volume-id>"
  if [ "$DRY_RUN" -eq 0 ]; then
    vol_id="$(plist doctl compute volume list --format ID,Name --no-header | awk -v n="$name-data" '$2==n {print $1; exit}')"
  fi
  if [ "$DRY_RUN" -eq 1 ] || [ -z "$vol_id" ]; then
    run doctl compute volume create "$name-data" --region "$region" --size "${disk}GiB" --fs-type ext4 --desc "outpost snapchain data"
    [ "$DRY_RUN" -eq 0 ] && vol_id="$(plist doctl compute volume list --format ID,Name --no-header | awk -v n="$name-data" '$2==n {print $1; exit}')"
  fi
  # DigitalOcean rejects a firewall that names a tag which does not exist yet (HTTP 422).
  if [ "$DRY_RUN" -eq 1 ] || ! doctl compute tag get "$name" >/dev/null 2>&1; then
    run doctl compute tag create "$name"
  fi
  if [ "$DRY_RUN" -eq 1 ] || ! plist doctl compute firewall list --format Name --no-header | grep -qx "$name-fw"; then
    run doctl compute firewall create --name "$name-fw" --tag-names "$name" \
      --inbound-rules "protocol:tcp,ports:22,address:0.0.0.0/0,address:::/0 protocol:udp,ports:3382,address:0.0.0.0/0,address:::/0" \
      --outbound-rules "protocol:tcp,ports:all,address:0.0.0.0/0,address:::/0 protocol:udp,ports:all,address:0.0.0.0/0,address:::/0 protocol:icmp,address:0.0.0.0/0,address:::/0"
  fi
  ud="$(mktemp)"
  render_cloud_init "$key.pub" "$ud"
  run doctl compute droplet create "$name" --region "$region" --size "$size" --image ubuntu-24-04-x64 \
    --ssh-keys "$fp" --user-data-file "$ud" --volumes "$vol_id" --tag-name "$name" --wait
  rm -f "$ud"
  [ "$DRY_RUN" -eq 1 ] && return 0
  do_ensure_attached "$name"
  ip="$(do_server_ip "$name")"
  [ -n "$ip" ] || die "droplet created but has no public IP yet; run ./outpost provision again in a minute"
  state_set PROVIDER "do"; state_set NAME "$name"; state_set IP "$ip"
}

provision_hetzner() {
  local name="$1" location="${2:-fsn1}" type="${3:-ccx33}" key="$4" disk="$5"
  require_cli hcloud "See https://github.com/hetznercloud/cli then run: hcloud context create outpost"
  local ip=""
  [ "$DRY_RUN" -eq 0 ] && ip="$(hcloud server ip "$name" 2>/dev/null || true)"
  if [ -n "$ip" ]; then
    say "server $name already exists at $ip"
    state_set PROVIDER hetzner; state_set NAME "$name"; state_set IP "$ip"
    return 0
  fi
  say "Hetzner: server $name ($type) in $location with a $disk GB volume."
  say "Billed by the hour while it exists. Check current prices for $type and volumes before you go on."
  # Seen 2026-10-18: a new account's 2000 GB create failed with "volumes size limit exceeded".
  if [ "$disk" -gt 1024 ]; then
    warn "new Hetzner accounts can hold at most 1024 GB of volumes in total, so this create may fail. 1000 GB is enough."
  fi
  confirm "Create it now?" || die "cancelled"

  local fp keyname ud
  fp="$(md5_fingerprint "$key.pub")"
  keyname=""
  [ "$DRY_RUN" -eq 0 ] && keyname="$(plist hcloud ssh-key list -o noheader -o columns=name,fingerprint | awk -v f="$fp" '$2==f {print $1; exit}')"
  if [ -z "$keyname" ]; then
    keyname="$name-key"
    run hcloud ssh-key create --name "$keyname" --public-key-from-file "$key.pub"
  fi
  if [ "$DRY_RUN" -eq 1 ] || ! hcloud firewall describe "$name-fw" >/dev/null 2>&1; then
    local rules
    rules="$(mktemp)"
    cat >"$rules" <<'JSON'
[
  {"direction": "in", "protocol": "tcp", "port": "22", "source_ips": ["0.0.0.0/0", "::/0"], "description": "ssh"},
  {"direction": "in", "protocol": "udp", "port": "3382", "source_ips": ["0.0.0.0/0", "::/0"], "description": "snapchain gossip"}
]
JSON
    run hcloud firewall create --name "$name-fw" --rules-file "$rules"
    rm -f "$rules"
  fi
  if [ "$DRY_RUN" -eq 1 ] || ! hcloud volume describe "$name-data" >/dev/null 2>&1; then
    run hcloud volume create --name "$name-data" --size "$disk" --location "$location" --format ext4
  fi
  ud="$(mktemp)"
  render_cloud_init "$key.pub" "$ud"
  run hcloud server create --name "$name" --type "$type" --image ubuntu-24.04 --location "$location" \
    --ssh-key "$keyname" --user-data-from-file "$ud" --firewall "$name-fw" --volume "$name-data" --automount
  rm -f "$ud"
  [ "$DRY_RUN" -eq 1 ] && return 0
  ip="$(hcloud server ip "$name")"
  state_set PROVIDER hetzner; state_set NAME "$name"; state_set IP "$ip"
}

wait_for_ssh() {
  [ "$DRY_RUN" -eq 1 ] && return 0
  say "waiting for the server to accept SSH and finish first boot..."
  for _ in $(seq 1 60); do
    if node_ssh 'test -f /var/lib/outpost-ready || cloud-init status --wait >/dev/null 2>&1; test -f /var/lib/outpost-ready' 2>/dev/null; then
      say "server ready: $(node_host)"
      return 0
    fi
    sleep 10
  done
  die "server did not come up within 10 minutes. Check it in your provider's console."
}

cmd_provision() {
  local provider="" name="${OUTPOST_NAME:-outpost-node}" region="" size="" disk="${OUTPOST_DISK_GB:-}" wait=1 watch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --region|--location) region="$2"; shift 2 ;;
      --size|--type) size="$2"; shift 2 ;;
      --disk) disk="$2"; shift 2 ;;
      --watchdog) watch="$2"; shift 2 ;;
      --dry-run) DRY_RUN=1; shift ;;
      --yes|-y) ASSUME_YES=1; shift ;;
      --no-wait) wait=0; shift ;;
      *) die "unknown option for provision: $1" ;;
    esac
  done
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{1,40}$ ]] || die "server name must be lowercase letters, digits and dashes"
  if [ -n "$watch" ]; then check_hours --watchdog "$watch"; watch=$((10#$watch)); fi
  provider="$(pick_provider "$provider")"
  # New Hetzner accounts can hold at most 1024 GB of volumes, so Hetzner gets 1000 GB.
  if [ -z "$disk" ]; then
    if [ "$provider" = hetzner ]; then disk=1000; else disk=1200; fi
  fi
  # The chain data was 557 GB on 2026-10-18 and grows; below 1 TB leaves no room.
  if ! [[ "$disk" =~ ^[0-9]+$ ]] || [ "$disk" -lt 1000 ]; then
    die "--disk is the volume size in GB, at least 1000 (default 1200, 1000 on Hetzner)"
  fi
  local key
  key="$(ssh_key_path)"
  state_set SSH_KEY "$key"
  case "$provider" in
    "do") provision_do "$name" "$region" "$size" "$key" "$disk" ;;
    hetzner) provision_hetzner "$name" "$region" "$size" "$key" "$disk" ;;
  esac
  # Armed before waiting for SSH, so a server that never comes up is deleted too.
  if [ -n "$watch" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      say "watchdog: would delete $name, its volume and its firewall after $watch hours, or after 2 hours with no progress"
    else
      watchdog_start "$watch" 2
    fi
  fi
  [ "$wait" -eq 1 ] && wait_for_ssh
  [ "$DRY_RUN" -eq 1 ] || say "next: ./outpost node"
}

# ---- node

cmd_node() {
  local wait=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-wait) wait=0; shift ;;
      *) die "unknown option for node: $1" ;;
    esac
  done
  local host
  host="$(node_host)"
  say "setting up the read node on $host"
  node_ssh 'mkdir -p /usr/local/lib/outpost && cat >/usr/local/lib/outpost/node-setup.sh' <"$OUTPOST_DIR/infra/node-setup.sh"
  node_ssh 'cat >/usr/local/lib/outpost/snapshot-restore.sh' <"$OUTPOST_DIR/infra/snapshot-restore.sh"
  node_ssh 'bash /usr/local/lib/outpost/node-setup.sh'
  [ "$wait" -eq 1 ] || { say "started. Check progress with ./outpost status"; return 0; }
  say ""
  say "The node downloads a snapshot of the network (about 560 GB), loads it, then catches up"
  say "on the blocks since. On our test server loading took about 1 hour 45 minutes and"
  say "catching up about 4 hours more. The client works once loading is done; the newest casts"
  say "appear as it catches up. You can press Ctrl-C at any time; the node keeps going."
  say "Check later with ./outpost status."
  local last=""
  while true; do
    local line
    line="$(node_progress)"
    if [ "$line" != "$last" ]; then say "$(date -u +%H:%M) $line"; last="$line"; fi
    case "$line" in synced*) say "next: ./outpost client"; return 0 ;; esac
    sleep 60
  done
}

# Prints one line: snapshot progress, catch-up state, or "synced".
node_progress() {
  # shellcheck disable=SC2016 # runs on the server; expands there
  node_ssh_for "${OUTPOST_SSH_CHECK_SECS:-60}" 'set -o pipefail
    info=$(curl -s -m 5 http://127.0.0.1:3381/v1/info || true)
    if [ -n "$info" ]; then
      # All shards. Shard 0 has no casts, but app keys are checked there.
      max=$(echo "$info" | jq "[.shardInfos[].blockDelay] | max // 1000000000")
      s0=$(echo "$info" | jq "[.shardInfos[] | select(.shardId == 0) | .blockDelay] | max // 0")
      if [ "$max" -lt 10 ]; then echo "synced: every shard is within $max blocks of the tip"
      elif [ "$s0" -ge 1000000 ]; then echo "shard 0 is $s0 blocks behind: feeds work, adding app keys fails. Its snapshot did not load; see \"Shard 0 did not load\" in the README"
      else echo "catching up: furthest shard is $max blocks behind"; fi
    else
      if systemctl is-active --quiet outpost-restore 2>/dev/null; then echo "loading snapshot: $(cat /var/lib/outpost/restore.progress 2>/dev/null)"; exit 0; fi
      if grep -qs "^failed" /var/lib/outpost/restore.progress; then echo "snapshot load stopped: $(cat /var/lib/outpost/restore.progress). Run ./outpost node again to resume"; exit 0; fi
      c=$(docker ps -qf name=snapchain-snapchain || true)
      [ -n "$c" ] || { echo "node container is not running"; exit 0; }
      p=$(docker logs --tail 200 "$c" 2>&1 | sed "s/\x1b\[[0-9;]*m//g" | grep -oE "Progress: [0-9]+/[0-9]+ chunks \([0-9]+%\) \(ETA: [^)]*\)" | tail -1)
      if [ -n "$p" ]; then echo "downloading snapshot: $p"; else echo "loading snapshot into the database (no API yet)"; fi
    fi' 2>/dev/null || echo "cannot reach the server over SSH"
}

# ---- client

# Unix sockets paths are limited to ~104 bytes, so keep this short; %C is ssh's hash of
# user, host and port.
tunnel_socket() { echo "$HOME/.ssh/outpost-%C"; }

tunnel_up() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  local sock key host
  sock="$(tunnel_socket)"
  host="$(node_host)"
  key="$(ssh_key_path)"
  # A live master is not enough: its forward can hang while the session stays up.
  if ssh -S "$sock" -O check "root@$host" >/dev/null 2>&1; then
    curl -fsm 10 -o /dev/null "http://127.0.0.1:$TUNNEL_PORT/v1/info" && return 0
    ssh -S "$sock" -O exit "root@$host" >/dev/null 2>&1 || true
  fi
  ssh -i "$key" "${SSH_OPTS[@]}" -f -N -M -S "$sock" -o ExitOnForwardFailure=yes \
    -L "127.0.0.1:$TUNNEL_PORT:127.0.0.1:3381" "root@$host"
}

tunnel_down() {
  local sock
  sock="$(tunnel_socket)"
  local host
  host="${OUTPOST_HOST:-$(state_get IP)}"
  [ -n "$host" ] || return 0
  ssh -S "$sock" -O exit "root@$host" >/dev/null 2>&1 || true
}

ensure_build() {
  command -v node >/dev/null 2>&1 || die "Node.js 20 or newer is needed for the client. See https://nodejs.org"
  local major
  major="$(node -p 'process.versions.node.split(".")[0]')"
  [ "$major" -ge 20 ] || die "Node.js $major is too old; install 20 or newer"
  if [ ! -d "$OUTPOST_DIR/node_modules" ]; then
    say "installing client dependencies (npm ci)"
    (cd "$OUTPOST_DIR" && npm ci --no-audit --no-fund)
  fi
  if [ ! -f "$OUTPOST_DIR/dist/serve.js" ] || [ -n "$(find "$OUTPOST_DIR/src" -newer "$OUTPOST_DIR/dist/serve.js" -print -quit)" ]; then
    (cd "$OUTPOST_DIR" && node scripts/build.mjs)
  fi
}

# Firewall rule for HTTPS (443/tcp), used by --phone and by society mode.
phone_firewall() {
  local action="$1" provider name
  provider="$(state_get PROVIDER)"
  name="$(state_get NAME)"
  if [ -z "$provider" ] || [ -n "${OUTPOST_HOST:-}" ]; then
    say "open (or close) 443/tcp in your server's firewall yourself; Outpost did not create this server."
    return 0
  fi
  case "$provider" in
    "do")
      local fw
      fw="$(plist doctl compute firewall list --format ID,Name --no-header | awk -v n="$name-fw" '$2==n {print $1; exit}')"
      [ -n "$fw" ] || die "firewall $name-fw not found"
      run doctl compute firewall "$action-rules" "$fw" --inbound-rules "protocol:tcp,ports:443,address:0.0.0.0/0,address:::/0" || true
      ;;
    hetzner)
      # hcloud names them add-rule and delete-rule.
      local verb="$action"
      [ "$action" = remove ] && verb=delete
      run hcloud firewall "$verb-rule" "$name-fw" --direction in --protocol tcp --port 443 --source-ips 0.0.0.0/0 --source-ips ::/0 || true
      ;;
  esac
}

# True if the container exists on the server. Phone access and society mode both use 443/tcp,
# so turning one off must not close it under the other.
server_has_container() {
  node_ssh "docker inspect '$1' >/dev/null 2>&1"
}

# Serves the client from the server over HTTPS with a password, for use on a phone.
cmd_phone() {
  local mode="${1:-on}" host ip pwfile pw hash
  ip="$(node_host)"
  if [ "$mode" = "off" ]; then
    node_ssh 'OUTPOST_PHONE_OFF=1 bash -s' <"$OUTPOST_DIR/infra/phone-setup.sh"
    if server_has_container outpost-society; then say "society mode still uses 443/tcp; leaving it open"; else phone_firewall remove; fi
    say "phone access is off"
    return 0
  fi
  ensure_build
  host="${ip//./-}.sslip.io"
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  pwfile="$STATE_DIR/phone-password"
  if [ ! -s "$pwfile" ]; then
    (umask 077; node -e 'process.stdout.write(require("crypto").randomBytes(18).toString("base64url"))' >"$pwfile")
  fi
  pw="$(cat "$pwfile")"
  say "copying the client to the server"
  tar -C "$OUTPOST_DIR/dist/web" -czf - . | node_ssh 'mkdir -p /srv/outpost-web && rm -f /srv/outpost-web/*.js /srv/outpost-web/*.map && tar -xzf - -C /srv/outpost-web'
  # The password travels over SSH stdin, never as a command-line argument.
  hash="$(printf '%s\n%s\n' "$pw" "$pw" | node_ssh 'docker run --rm -i caddy:2.10.2 caddy hash-password')"
  [[ "$hash" == \$2* ]] || die "could not hash the password on the server"
  phone_firewall add
  node_ssh "OUTPOST_PHONE_HOST='$host' OUTPOST_PHONE_HASH='$hash' bash -s" <"$OUTPOST_DIR/infra/phone-setup.sh"
  say ""
  say "open https://$host on your phone"
  say "user: outpost   password: $pw   (saved in $pwfile)"
  say "the first visit can take a minute while the certificate is issued."
  say "turn it off with: ./outpost client --phone off"
}

cmd_client() {
  if [ "${1:-}" = "--phone" ]; then
    shift
    cmd_phone "$@"
    return
  fi
  ensure_build
  tunnel_up
  trap tunnel_down EXIT
  say "your node is reachable through an SSH tunnel on 127.0.0.1:$TUNNEL_PORT (no port opened on the server)"
  say "open http://127.0.0.1:$CLIENT_PORT in your browser. Ctrl-C stops the client."
  OUTPOST_NODE_URL="http://127.0.0.1:$TUNNEL_PORT" OUTPOST_PORT="$CLIENT_PORT" node "$OUTPOST_DIR/dist/serve.js"
}

cmd_cli() {
  ensure_build
  # Help needs no server.
  case "${1:-}" in ""|-h|--help|help) node "$OUTPOST_DIR/dist/cli.js" --help; return ;; esac
  tunnel_up
  OUTPOST_NODE_URL="http://127.0.0.1:$TUNNEL_PORT" node "$OUTPOST_DIR/dist/cli.js" "$@"
}

# ---- society

# Society mode: members use your node from their own browsers, with their own Farcaster
# accounts and their own token for the node. Caddy terminates TLS and src/server/gate.ts checks
# each request (see infra/society.sh). The server serves no web page; members load the client
# from GitHub Pages.
SOCIETY_APP="https://spider333.github.io/outpost/app/"

society_host() {
  local ip
  ip="$(node_host)"
  [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "society mode needs the server's IPv4 address for <ip>.sslip.io, not '$ip'"
  echo "${ip//./-}.sslip.io"
}

# Copies infra/society.sh to the server and runs it there: society_run "<VAR=value ...>" <action> [name].
# Both go into the remote command line, so callers pass only checked names and numbers.
society_run() {
  local env="$1"
  shift
  node_ssh 'mkdir -p /usr/local/lib/outpost && cat >/usr/local/lib/outpost/society.sh' <"$OUTPOST_DIR/infra/society.sh"
  node_ssh "${env}bash /usr/local/lib/outpost/society.sh $*"
}

cmd_society() {
  local mode="${1:-status}" host env="" v val
  host="$(society_host)"
  case "$mode" in
    on)
      # Per-member rate limits for the gate, passed on when set here.
      for v in OUTPOST_GATE_READ_RATE OUTPOST_GATE_READ_BURST OUTPOST_GATE_SUBMIT_RATE OUTPOST_GATE_SUBMIT_BURST; do
        val="${!v:-}"
        [ -n "$val" ] || continue
        [[ "$val" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "$v must be a number"
        env="$env$v=$val "
      done
      phone_firewall add
      society_run "${env}OUTPOST_SOCIETY_HOST='$host' " on <"$OUTPOST_DIR/src/server/gate.ts"
      say ""
      say "society node: https://$host (the node API for members; no web page)"
      say "add a member: ./outpost members add <name>"
      say "the first request can take a minute while the certificate is issued."
      say "turn it off with: ./outpost society off"
      ;;
    off)
      society_run "" off
      if server_has_container outpost-phone; then say "phone access still uses 443/tcp; leaving it open"; else phone_firewall remove; fi
      say "society mode is off"
      ;;
    status)
      say "society node: https://$host"
      society_run "" status
      ;;
    *) die "usage: ./outpost society on|off|status" ;;
  esac
}

cmd_members() {
  local action="${1:-list}" name="${2:-}" host token hash out
  case "$action" in
    add|remove)
      [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$ ]] || die "usage: ./outpost members $action <name> (letters, digits, '.', '_' or '-', up to 40)"
      ;;
    list) ;;
    *) die "usage: ./outpost members add <name>, ./outpost members remove <name>, ./outpost members list" ;;
  esac
  case "$action" in
    add)
      require_cli openssl "It ships with macOS and most Linux systems."
      host="$(society_host)"
      # The token is made here and only its SHA-256 goes to the server (over SSH stdin), so the
      # server never has it. Outpost keeps no copy: the link below is the only one.
      token="$(openssl rand -hex 32)"
      hash="$(printf '%s' "$token" | openssl dgst -sha256 | awk '{print $NF}')"
      [[ "$token" =~ ^[0-9a-f]{64}$ && "$hash" =~ ^[0-9a-f]{64}$ ]] || die "could not make a token with openssl"
      out="$(printf '%s\n' "$hash" | society_run "" add "$name")"
      if [ "$out" = exists ]; then
        say "$name is already a member. Their link was shown once, when they were added. For a new one:"
        say "  ./outpost members remove $name && ./outpost members add $name"
        return 0
      fi
      [ "$out" = added ] || die "unexpected answer from the server: $out"
      say "invite link for $name (shown once; send it privately, whoever has it can use the node as $name):"
      say "${SOCIETY_APP}#node=https%3A%2F%2F$host&token=$token"
      say "it works once society mode is on (./outpost society on). Remove with: ./outpost members remove $name"
      ;;
    remove) society_run "" remove "$name" ;;
    list) society_run "" list ;;
  esac
}

cmd_status() {
  [ -n "$(state_get IP)${OUTPOST_HOST:-}" ] || { say "no server yet. Run ./outpost provision"; return 0; }
  if [ -n "${OUTPOST_HOST:-}" ]; then
    say "server: $OUTPOST_HOST (OUTPOST_HOST)"
  else
    say "provider: $(state_get PROVIDER)  server: $(state_get NAME)  ip: $(state_get IP)"
  fi
  say "node: $(node_progress)"
  if [ -z "${OUTPOST_HOST:-}" ]; then watchdog_status; fi
}

cmd_uninstall() {
  say "revoking the CLI's app key with the key itself (no recovery phrase needed)"
  cmd_cli uninstall
  say "keys added in the web client are revoked from its 'Your app key' panel."
}

# DigitalOcean can still list a resource for a few seconds after deleting it (seen 2026-10-18:
# a second destroy got 404 on the volume). A failed delete is fine if the resource is gone:
# the API said 404, or a working list no longer shows it. Any other error (503, no network)
# says nothing about the resource, so it stops and the state is kept.
do_delete() {
  local kind="$1" rid="$2" label="$3" err
  if [ "$DRY_RUN" -eq 1 ]; then run doctl compute "$kind" delete "$rid" --force; return; fi
  err="$(doctl compute "$kind" delete "$rid" --force 2>&1 >/dev/null)" && return 0
  case "$err" in
    *404*) say "$kind $label: already gone"; return 0 ;;
  esac
  if do_listed "$kind" "$rid"; then die "could not delete $kind $label: $err"; fi
  say "$kind $label: already gone"
}

# Whether a DigitalOcean resource with this ID or name is listed. Like hz_has, it stops if
# the list itself fails: nothing may be called gone, or forgotten, unchecked.
do_listed() {
  local rows
  rows="$(plist doctl compute "$1" list --format ID,Name --no-header)" || die "cannot list DigitalOcean $1s, so the state is kept. Try again."
  printf '%s\n' "$rows" | awk -v r="$2" '$1==r || $2==r {f=1} END {exit !f}'
}

# Whether a Hetzner resource exists. A failed `describe` can also mean "no network", so this
# lists instead and stops if the list fails: nothing may be called gone, or forgotten, unchecked.
hz_has() {
  local names
  names="$(plist hcloud "$1" list -o noheader -o columns=name)" || die "cannot list Hetzner $1s, so nothing was deleted. Try again."
  printf '%s\n' "$names" | awk '{print $1}' | grep -qx "$2"
}

cmd_destroy() {
  local provider name
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --yes|-y) ASSUME_YES=1; shift ;;
      --name) OUTPOST_NAME="$2"; shift 2 ;;
      --provider) OUTPOST_PROVIDER="$2"; shift 2 ;;
      *) die "unknown option for destroy: $1" ;;
    esac
  done
  provider="$(pick_provider "${OUTPOST_PROVIDER:-}")"
  name="${OUTPOST_NAME:-$(state_get NAME)}"
  name="${name:-outpost-node}"
  say "This deletes server $name, its volume (all chain data) and its firewall on $provider."
  say "Your account, follows and casts are not affected; they live on the network, not on this server."
  if [ "$DRY_RUN" -eq 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
    local typed
    read -r -p "Type the server name ($name) to confirm: " typed
    [ "$typed" = "$name" ] || die "cancelled"
  fi
  tunnel_down
  case "$provider" in
    "do")
      require_cli doctl "Install doctl and run doctl auth init"
      local id vol ids
      id=""; vol=""
      if [ "$DRY_RUN" -eq 0 ]; then
        id="$(plist doctl compute droplet list --format ID,Name --no-header | awk -v n="$name" '$2==n {print $1; exit}')"
        vol="$(plist doctl compute volume list --format ID,Name --no-header | awk -v n="$name-data" '$2==n {print $1; exit}')"
      fi
      if [ "$DRY_RUN" -eq 1 ] || [ -n "$id" ]; then run doctl compute droplet delete "$name" --force; else say "droplet $name: already gone"; fi
      if [ "$DRY_RUN" -eq 1 ] || [ -n "$vol" ]; then
        # A volume can only be deleted once the droplet has released it.
        if [ "$DRY_RUN" -eq 0 ]; then
          for _ in $(seq 1 30); do
            # No answer means the wait is over, not that the volume is gone: do_delete checks.
            ids="$(doctl compute volume get "$vol" --format DropletIDs --no-header 2>/dev/null)" || break
            [ -z "$(printf '%s' "$ids" | tr -d '[] ')" ] && break
            sleep 5
          done
        fi
        do_delete volume "${vol:-<volume-id>}" "$name-data"
      else say "volume $name-data: already gone"; fi
      if [ "$DRY_RUN" -eq 1 ]; then
        run doctl compute firewall delete "<firewall-id of $name-fw>" --force
      else
        local fw
        fw="$(plist doctl compute firewall list --format ID,Name --no-header | awk -v n="$name-fw" '$2==n {print $1; exit}')"
        if [ -n "$fw" ]; then do_delete firewall "$fw" "$name-fw"; else say "firewall $name-fw: already gone"; fi
      fi
      # provision also creates the tag and, when your key is new to the account, "$name-key".
      if [ "$DRY_RUN" -eq 1 ] || doctl compute tag get "$name" >/dev/null 2>&1; then run doctl compute tag delete "$name" --force; fi
      local key_id=""
      [ "$DRY_RUN" -eq 0 ] && key_id="$(plist doctl compute ssh-key list --format ID,Name --no-header | awk -v n="$name-key" '$2==n {print $1; exit}')"
      if [ "$DRY_RUN" -eq 1 ] || [ -n "$key_id" ]; then do_delete ssh-key "${key_id:-<key-id of $name-key>}" "$name-key"; fi
      ;;
    hetzner)
      require_cli hcloud "Install hcloud and run hcloud context create outpost"
      if [ "$DRY_RUN" -eq 1 ] || hz_has server "$name"; then run hcloud server delete "$name"; else say "server $name: already gone"; fi
      if [ "$DRY_RUN" -eq 1 ] || hz_has volume "$name-data"; then run hcloud volume delete "$name-data"; else say "volume $name-data: already gone"; fi
      if [ "$DRY_RUN" -eq 1 ] || hz_has firewall "$name-fw"; then run hcloud firewall delete "$name-fw"; else say "firewall $name-fw: already gone"; fi
      if [ "$DRY_RUN" -eq 1 ] || hz_has ssh-key "$name-key"; then run hcloud ssh-key delete "$name-key"; fi
      ;;
  esac
  if [ "$DRY_RUN" -eq 0 ]; then
    # Forget the server only if it is the one in our state.
    if [ "$name" = "$(state_get NAME)" ]; then
      rm -f "$STATE_FILE" "$STATE_DIR/known_hosts" "$STATE_DIR/phone-password"
    fi
    say "done. Billing for these resources has stopped."
  fi
}

# ---- watchdog

# Runs on this computer, not on the server: deleting needs your provider login, which never
# goes to the server. While the computer sleeps it waits; on waking it acts on the clock.
HOUR_SECS="${OUTPOST_HOUR_SECS:-3600}" # tests shorten the hour
WATCHDOG_PID="$STATE_DIR/watchdog.pid"
WATCHDOG_LOG="$STATE_DIR/watchdog.log"

# Hours are read as decimal (08 is 8; bash would read it as octal) and capped at 720 (30 days),
# so a typo cannot overflow the deadline. Callers then use $((10#$value)).
check_hours() {
  if ! [[ "$2" =~ ^[0-9]{1,4}$ ]] || [ $((10#$2)) -lt 1 ] || [ $((10#$2)) -gt 720 ]; then
    die "$1 takes a whole number of hours from 1 to 720"
  fi
}

fmt_time() { date -u -d "@$1" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || date -u -r "$1" '+%Y-%m-%d %H:%M UTC'; }

# Checks the command line too: after a restart the saved pid can belong to another program,
# or to the watchdog of another checkout. It must be exactly bash running this checkout's
# outpost. (Not checked: a second state dir in this checkout.)
watchdog_running() {
  local pid cmd
  pid="$(cat "$WATCHDOG_PID" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  cmd="$(ps -p "$pid" -o command= 2>/dev/null)" || return 1
  case "$cmd" in
    bash" $OUTPOST_DIR/outpost watchdog run" | */bash" $OUTPOST_DIR/outpost watchdog run") return 0 ;;
  esac
  return 1
}

watchdog_start() {
  local hours="$1" stall="$2" deadline
  check_hours --hours "$hours"
  check_hours --stall-hours "$stall"
  hours=$((10#$hours)) stall=$((10#$stall))
  if [ -n "${OUTPOST_HOST:-}" ] || [ -z "$(state_get NAME)" ] || [ -z "$(state_get PROVIDER)" ]; then
    die "the watchdog only deletes a server made here by ./outpost provision"
  fi
  if watchdog_running; then kill "$(cat "$WATCHDOG_PID")" 2>/dev/null || true; fi
  deadline=$(($(date +%s) + hours * HOUR_SECS))
  state_set WATCHDOG_DEADLINE "$deadline"
  state_set WATCHDOG_DELETING ""
  state_set WATCHDOG_STALL_HOURS "$stall"
  nohup "$OUTPOST_DIR/outpost" watchdog run >>"$WATCHDOG_LOG" 2>&1 </dev/null &
  echo $! >"$WATCHDOG_PID"
  say "watchdog on: it deletes $(state_get NAME), its volume and its firewall at $(fmt_time "$deadline"),"
  say "or sooner if the node makes no progress for $stall hours once it has started."
  say "It runs on this computer; if the computer sleeps, it acts when it wakes. Log: $WATCHDOG_LOG"
  say "To keep the server: ./outpost watchdog stop"
}

watchdog_stop() {
  local was_running=0 deleting
  deleting="$(state_get WATCHDOG_DELETING)"
  if watchdog_running; then was_running=1; kill "$(cat "$WATCHDOG_PID")" 2>/dev/null || true; fi
  rm -f "$WATCHDOG_PID"
  if [ ! -f "$STATE_FILE" ]; then say "watchdog off; there is no server here any more"; return 0; fi
  state_set WATCHDOG_DEADLINE ""
  # Killing the watchdog does not stop a destroy it has already started; it only stops retries.
  if [ "$was_running" -eq 1 ] && [ "$deleting" = running ]; then
    say "watchdog off, but it had already started deleting the server. That attempt carries on and"
    say "is not retried: check with ./outpost status, and run ./outpost destroy if anything is left."
  elif [ "$was_running" -eq 1 ] && [ "$deleting" = retry ]; then
    say "watchdog off. Its last attempt to delete the server failed, so the server may still exist:"
    say "run ./outpost destroy to finish deleting it."
  else
    say "watchdog off: the server stays until you run ./outpost destroy"
  fi
}

watchdog_status() {
  local deadline
  deadline="$(state_get WATCHDOG_DEADLINE)"
  if [ -z "$deadline" ]; then
    say "watchdog: off"
  elif watchdog_running; then
    say "watchdog: deletes the server at $(fmt_time "$deadline"), or after $(state_get WATCHDOG_STALL_HOURS) hours with no progress"
  else
    say "watchdog: set for $(fmt_time "$deadline") but not running (did this computer restart?). Start it again: ./outpost watchdog start --hours <n>"
  fi
}

watchdog_run() {
  local interval="${OUTPOST_WATCHDOG_INTERVAL:-300}" last="" started=0 since now deadline stall line reason pending=""
  since="$(date +%s)"
  while true; do
    if [ ! -f "$STATE_FILE" ]; then
      say "$(date -u +%H:%M) the server is gone; watchdog done"
      rm -f "$WATCHDOG_PID"
      return 0
    fi
    deadline="$(state_get WATCHDOG_DEADLINE)"
    [ -n "$deadline" ] || { say "$(date -u +%H:%M) watchdog turned off"; return 0; }
    stall="$(state_get WATCHDOG_STALL_HOURS)"
    [[ "$stall" =~ ^[0-9]{1,4}$ ]] || stall=2
    stall=$((10#$stall))
    now="$(date +%s)"
    # Once it has decided to delete, it retries until the deletion is done: after a partial
    # delete the server no longer answers, so the stall clock can no longer be trusted.
    reason="$pending"
    if [ -n "$reason" ]; then
      :
    elif [ "$now" -ge "$deadline" ]; then
      reason="time limit reached"
    else
      line="$(node_progress)"
      case "$line" in
        # Offline here is not a stall there: the stall clock restarts, the time limit still applies.
        "cannot reach the server over SSH") since="$now" ;;
        # Before ./outpost node has run, only the time limit applies.
        "node container is not running") [ "$started" -eq 0 ] || [ "$line" = "$last" ] || { last="$line"; since="$now"; } ;;
        # Snapchain's own loader, and the node opening its database, print no progress for
        # long stretches: only the time limit applies there.
        "downloading snapshot:"* | "loading snapshot into the database"*) started=1; last="$line"; since="$now" ;;
        synced*) started=1; last="$line"; since="$now" ;;
        *) started=1
          if [ "$line" != "$last" ]; then last="$line"; since="$now"; fi ;;
      esac
      if [ "$started" -eq 1 ] && [ $((now - since)) -ge $((stall * HOUR_SECS)) ]; then
        reason="no progress for $stall hours ($last)"
      fi
    fi
    if [ -n "$reason" ]; then
      say "$(date -u +%H:%M) $reason: deleting the server"
      state_set WATCHDOG_DELETING running
      if "$OUTPOST_DIR/outpost" destroy --yes; then
        rm -f "$WATCHDOG_PID"
        return 0
      fi
      pending="$reason"
      [ ! -f "$STATE_FILE" ] || state_set WATCHDOG_DELETING retry
      say "$(date -u +%H:%M) destroy failed; trying again in $interval seconds"
    fi
    sleep "$interval"
  done
}

cmd_watchdog() {
  local sub="${1:-status}" hours=24 stall=2
  [ $# -gt 0 ] && shift
  case "$sub" in
    start)
      while [ $# -gt 0 ]; do
        case "$1" in
          --hours) hours="$2"; shift 2 ;;
          --stall-hours) stall="$2"; shift 2 ;;
          *) die "unknown option for watchdog start: $1" ;;
        esac
      done
      watchdog_start "$hours" "$stall"
      ;;
    stop) watchdog_stop ;;
    status) watchdog_status ;;
    run) watchdog_run ;;
    *) die "use: ./outpost watchdog start [--hours 24] [--stall-hours 2] | stop | status" ;;
  esac
}

usage() {
  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    provision) cmd_provision "$@" ;;
    node) cmd_node "$@" ;;
    client) cmd_client "$@" ;;
    society) cmd_society "$@" ;;
    members) cmd_members "$@" ;;
    cli) cmd_cli "$@" ;;
    status) cmd_status "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    destroy) cmd_destroy "$@" ;;
    watchdog) cmd_watchdog "$@" ;;
    ""|-h|--help|help) usage ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
