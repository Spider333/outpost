{
  "name": "outpost",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@farcaster/core": "0.20.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@farcaster/hub-nodejs": "0.17.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "outpost-cli": "tsx src/cli/main.ts",
    "build": "node scripts/build.mjs",
    "client": "node scripts/build.mjs && node dist/serve.js",
    "test:providers": "bash test/providers.sh",
    "test:restore": "bash test/snapshot-restore.sh"
  }
}
