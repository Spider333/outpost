#!/usr/bin/env bash
# Fake doctl: keeps resources as "id name ip" lines and honours --format.
S="${FAKE_STATE:?}"; echo "doctl $*" >> "$S/calls.log"
# Like the API with no network: every call fails.
[ -e "$S/api-down" ] && { echo "Error: dial tcp: network is unreachable" >&2; exit 1; }
# Like a DigitalOcean outage for volumes only: get and delete answer 503, the rest works.
case "$1 $2 $3" in "compute volume get"|"compute volume delete")
  [ -e "$S/volume-503" ] && { echo "Error: 503 Service Unavailable" >&2; exit 1; } ;; esac
fmt=""; tag=""; prev=""; for a in "$@"; do [ "$prev" = "--format" ] && fmt="$a"; [ "$prev" = "--tag-names" ] && tag="$a"; prev="$a"; done
list() { # $1 = file glob prefix
  for f in "$S"/$1.*; do [ -e "$f" ] || continue; read -r id name ip < "$f"
    case "$fmt" in ID,Name) echo "$id $name";; Name) echo "$name";; Name,PublicIPv4) echo "$name $ip";; DropletIDs) echo "[]";; *) echo "$id $name $ip";; esac; done; }
case "$1 $2 $3" in
  "compute droplet list") list droplet ;;
  "compute droplet create") echo "d-1 $4 203.0.113.7" > "$S/droplet.$4"
    # Like DigitalOcean on a bad day: --volumes is accepted but nothing is attached.
    [ -n "${FAKE_SKIP_ATTACH:-}" ] || : > "$S/attached" ;;
  "compute droplet delete") [ -z "${FAKE_DELETE_SECS:-}" ] || sleep "$FAKE_DELETE_SECS"
    rm -f "$S/droplet.$4" "$S/attached"
    # Like the network dropping in the middle of a destroy.
    if [ -e "$S/drop-after-droplet-delete" ]; then : >"$S/api-down"; fi ;;
  "compute volume list") list volume
    # Like DigitalOcean just after a delete: still listed, but gone.
    if [ -n "${FAKE_STALE_VOLUME:-}" ]; then case "$fmt" in ID,Name) echo "vol-ghost $FAKE_STALE_VOLUME";; *) echo "$FAKE_STALE_VOLUME";; esac; fi ;;
  "compute volume create") if [ -n "${FAKE_VOLUME_LIMIT:-}" ]; then echo "Error: POST https://api.digitalocean.com/v2/volumes: 422 failed to create volume: invalid size specified" >&2; exit 1; fi
    echo "vol-123 $4" > "$S/volume.$4"
    # Like a request that times out after DigitalOcean made the volume.
    if [ -n "${FAKE_VOLUME_TIMEOUT:-}" ]; then echo "Error: context deadline exceeded" >&2; exit 1; fi ;;
  "compute volume get") [ "$4" != vol-ghost ] || exit 1
    if [ -e "$S/attached" ]; then echo "[d-1]"; else echo "[]"; fi ;;
  "compute volume-action attach") : > "$S/attached" ;;
  "compute volume delete") [ "$4" != vol-ghost ] || { echo "Error: 404 allocation not found" >&2; exit 1; }
    for f in "$S"/volume.*; do grep -q "^$4 " "$f" && rm -f "$f"; done ;;
  "compute firewall list") list fw ;;
  "compute firewall create") # like DigitalOcean: HTTP 422 when the tag does not exist yet
    [ -e "$S/tag.$tag" ] || { echo "Error: tag $tag does not exist (422)" >&2; exit 1; }
    echo "fw-9 $5" > "$S/fw.$5" ;;
  "compute firewall delete") for f in "$S"/fw.*; do grep -q "^$4 " "$f" && rm -f "$f"; done ;;
  "compute firewall add-rules") : > "$S/fw443" ;;
  "compute firewall remove-rules") rm -f "$S/fw443" ;;
  "compute ssh-key get") ls "$S"/sshkey.* >/dev/null 2>&1 || exit 1 ;;
  "compute ssh-key import") echo "k-1 $4" > "$S/sshkey.$4" ;;
  "compute ssh-key list") list sshkey ;;
  "compute ssh-key delete") for f in "$S"/sshkey.*; do grep -q "^$4 " "$f" && rm -f "$f"; done ;;
  "compute tag get") [ -e "$S/tag.$4" ] || exit 1 ;;
  "compute tag create") echo "t-1 $4" > "$S/tag.$4" ;;
  "compute tag delete") rm -f "$S/tag.$4" ;;
  *) echo "fake doctl: unhandled $*" >&2; exit 3 ;;
esac
